# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Supabase (hosted Postgres) -------------------------------------------------
# Project Settings > Database > Connect. Port 5432 (session pooler) is preferred;
# the transaction pooler on 6543 works only with prepareThreshold=0, as below.
SUPABASE_DB_URL=jdbc:postgresql://<host>.pooler.supabase.com:6543/postgres?prepareThreshold=0
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# --- Secrets ---------------------------------------------------------------------
# HS256 key signing access tokens.        openssl rand -base64 48
JWT_SECRET=
# AES-256 key encrypting the Jira/GitHub tokens stored per tenant. Rotating this
# invalidates every stored credential.    openssl rand -base64 32
APP_SECRET_KEY=

# --- Optional --------------------------------------------------------------------
ANTHROPIC_API_KEY=
PORT=4000

# Jira and GitHub credentials are NOT configured here any more. They belong to a
# tenant, not to the server, and are created per tenant via POST /connections.

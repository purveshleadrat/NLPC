# Backend origin, no trailing slash and no /api suffix (the app's own paths already
# start with /jira, /auth, /initiatives, etc. matching the backend's real routes).
#
# Save this as `.env.production`, NOT plain `.env` - Vite loads `.env` in every mode
# including local dev, which would make `npm run dev` call this URL directly and hit
# CORS (no same-origin proxy). `.env.production` only applies to `vite build`, so local
# dev keeps using the proxy in vite.config.js (/api -> http://localhost:4000).
VITE_API_URL=https://your-backend.onrender.com
